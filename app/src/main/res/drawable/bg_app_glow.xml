<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das telas principais: branco azulado com brilhos difusos (radiais) em tons de azul -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tqf_glow_base" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.08"
                android:endColor="@android:color/transparent"
                android:gradientRadius="55%p"
                android:startColor="@color/tqf_glow_sky"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.0"
                android:centerY="0.45"
                android:endColor="@android:color/transparent"
                android:gradientRadius="50%p"
                android:startColor="@color/tqf_glow_blue"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.95"
                android:endColor="@android:color/transparent"
                android:gradientRadius="55%p"
                android:startColor="@color/tqf_glow_indigo"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
