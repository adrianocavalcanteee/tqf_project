<?xml version="1.0" encoding="utf-8"?>
<!-- Pílula selecionável (chips de categoria): selecionada azul sólido, normal azul claro -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tqf_radius_pill" />
            <solid android:color="@color/tqf_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tqf_radius_pill" />
            <solid android:color="@color/tqf_primary_soft" />
        </shape>
    </item>
</selector>
