<?xml version="1.0" encoding="utf-8"?>
<!-- Pílula de navegação em vidro branco translúcido: base em degradê, brilho na metade superior,
     reflexo diagonal, aro claro e aro interno escuro bem sutil (contorno sobre fundos claros). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tqf_radius_nav" />
            <gradient
                android:angle="270"
                android:endColor="@color/tqf_glass_bottom"
                android:startColor="@color/tqf_glass_top" />
        </shape>
    </item>
    <!-- Reflexo diagonal -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tqf_radius_nav" />
            <gradient
                android:angle="330"
                android:centerColor="@color/tqf_glass_sheen"
                android:centerX="0.42"
                android:endColor="@android:color/transparent"
                android:startColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Brilho na metade superior -->
    <item
        android:bottom="30dp"
        android:left="14dp"
        android:right="14dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/tqf_radius_nav"
                android:topRightRadius="@dimen/tqf_radius_nav" />
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/tqf_glass_gloss" />
        </shape>
    </item>
    <!-- Aro externo claro -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tqf_radius_nav" />
            <stroke
                android:width="1.5dp"
                android:color="@color/tqf_glass_rim" />
        </shape>
    </item>
    <!-- Aro interno sutil -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tqf_radius_nav" />
            <stroke
                android:width="1dp"
                android:color="@color/tqf_glass_rim_inner" />
        </shape>
    </item>
</layer-list>
