<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TQFapp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_blue_light</item>
        <item name="colorOnSecondary">@color/brand_blue</item>
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/bg_app</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>