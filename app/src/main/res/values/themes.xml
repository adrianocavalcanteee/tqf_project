<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================================================================
         Design system TQF. Tema único do app: cores (colors.xml), medidas (dimens.xml)
         e estilos padrão dos componentes. As telas usam estes estilos em vez de valores soltos.
         Visual claro (fundo #F4F8FF), cards brancos arredondados, sombras suaves, azul de destaque.
         ============================================================================= -->
    <style name="Theme.TQFapp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/tqf_primary</item>
        <item name="colorPrimaryVariant">@color/tqf_primary_pressed</item>
        <item name="colorOnPrimary">@color/tqf_text_on_primary</item>
        <item name="colorSecondary">@color/tqf_primary</item>
        <item name="colorOnSecondary">@color/tqf_text_on_primary</item>
        <item name="colorSurface">@color/tqf_surface</item>
        <item name="colorOnSurface">@color/tqf_text</item>
        <item name="colorControlActivated">@color/tqf_primary</item>
        <item name="colorControlHighlight">@color/tqf_primary_soft_pressed</item>
        <item name="android:textColorPrimary">@color/tqf_text</item>
        <item name="android:textColorSecondary">@color/tqf_text_secondary</item>
        <item name="android:textColorHint">@color/tqf_text_muted</item>

        <item name="android:windowBackground">@color/tqf_background</item>
        <item name="android:statusBarColor">@color/tqf_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/tqf_surface</item>

        <!-- Tipografia: família única (troque aqui para Poppins/Inter quando a fonte for adicionada) -->
        <item name="android:fontFamily">@string/tqf_font_regular</item>

        <!-- Formas -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TQF.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TQF.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TQF.Large</item>

        <!-- Componentes padrão -->
        <item name="materialButtonStyle">@style/Widget.TQF.Button</item>
        <item name="materialCardViewStyle">@style/Widget.TQF.Card</item>
        <item name="textInputStyle">@style/Widget.TQF.TextInput</item>
        <item name="chipStyle">@style/Widget.TQF.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TQF.Dialog</item>
        <item name="switchStyle">@style/Widget.TQF.Switch</item>
    </style>

    <!-- ===== Formas ===== -->
    <style name="ShapeAppearance.TQF.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tqf_radius_button</item>
    </style>
    <style name="ShapeAppearance.TQF.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tqf_radius_card</item>
    </style>
    <style name="ShapeAppearance.TQF.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tqf_radius_card</item>
    </style>
    <style name="ShapeAppearance.TQF.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tqf_radius_field</item>
    </style>
    <style name="ShapeAppearance.TQF.Tile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tqf_radius_tile</item>
    </style>
    <style name="ShapeAppearance.TQF.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Tipografia ===== -->
    <style name="TextAppearance.TQF.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/tqf_text_display</item>
        <item name="android:textColor">@color/tqf_text</item>
        <item name="android:fontFamily">@string/tqf_font_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.TQF.Headline" parent="TextAppearance.TQF.Display">
        <item name="android:textSize">@dimen/tqf_text_headline</item>
    </style>
    <style name="TextAppearance.TQF.Title" parent="TextAppearance.TQF.Display">
        <item name="android:textSize">@dimen/tqf_text_title</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TQF.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/tqf_text_subtitle</item>
        <item name="android:textColor">@color/tqf_text</item>
        <item name="android:fontFamily">@string/tqf_font_medium</item>
    </style>
    <style name="TextAppearance.TQF.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/tqf_text_body</item>
        <item name="android:textColor">@color/tqf_text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.TQF.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/tqf_text_caption</item>
        <item name="android:textColor">@color/tqf_text_muted</item>
    </style>
    <style name="TextAppearance.TQF.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">@dimen/tqf_text_subtitle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@string/tqf_font_medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cabeçalho de seção: título em bold (o link "Ver todos" usa Widget.TQF.Link) -->
    <style name="Widget.TQF.SectionTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.TQF.Title</item>
        <item name="android:textColor">@color/tqf_text</item>
    </style>
    <style name="Widget.TQF.Link" parent="">
        <item name="android:textColor">@color/tqf_primary</item>
        <item name="android:textSize">@dimen/tqf_text_caption</item>
        <item name="android:fontFamily">@string/tqf_font_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/tqf_touch_target</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/tqf_space_xxs</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===== Botões ===== -->
    <!-- Primário: azul, largura total nas telas, texto branco, raio 16dp -->
    <style name="Widget.TQF.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/tqf_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">@dimen/tqf_space_lg</item>
        <item name="cornerRadius">@dimen/tqf_radius_button</item>
        <item name="backgroundTint">@color/tqf_button_primary_bg</item>
        <item name="android:textColor">@color/tqf_text_on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.TQF.Button</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconTint">@color/tqf_text_on_primary</item>
        <item name="rippleColor">@color/tqf_primary_pressed</item>
    </style>
    <!-- Secundário: fundo azul claro, texto azul -->
    <style name="Widget.TQF.Button.Soft">
        <item name="backgroundTint">@color/tqf_primary_soft</item>
        <item name="android:textColor">@color/tqf_primary</item>
        <item name="iconTint">@color/tqf_primary</item>
        <item name="rippleColor">@color/tqf_primary_soft_pressed</item>
    </style>
    <!-- Contorno discreto (ações neutras/negativas, ex.: Recusar) -->
    <style name="Widget.TQF.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/tqf_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/tqf_radius_button</item>
        <item name="strokeColor">@color/tqf_divider</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/tqf_text</item>
        <item name="android:textAppearance">@style/TextAppearance.TQF.Button</item>
        <item name="rippleColor">@color/tqf_primary_soft_pressed</item>
    </style>
    <style name="Widget.TQF.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/tqf_touch_target</item>
        <item name="android:textColor">@color/tqf_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.TQF.Button</item>
        <item name="android:textSize">@dimen/tqf_text_body</item>
    </style>

    <!-- Segmented control (Contratante | Prestador): trilho bg_segment_track + opções deste estilo -->
    <style name="Widget.TQF.Button.Segment" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/tqf_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/tqf_segment_bg</item>
        <item name="android:textAppearance">@style/TextAppearance.TQF.Button</item>
        <item name="android:textSize">@dimen/tqf_text_body</item>
        <item name="rippleColor">@color/tqf_primary_soft_pressed</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ===== Cards ===== -->
    <style name="Widget.TQF.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/tqf_radius_card</item>
        <item name="cardElevation">@dimen/tqf_elevation_card</item>
        <item name="cardBackgroundColor">@color/tqf_surface</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/tqf_primary_soft_pressed</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/tqf_shadow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/tqf_shadow</item>
    </style>
    <!-- Superfície azul clara sem sombra (tiles, caixas de informação) -->
    <style name="Widget.TQF.Card.Soft">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/tqf_radius_tile</item>
        <item name="cardBackgroundColor">@color/tqf_primary_soft</item>
    </style>

    <!-- ===== Campos ===== -->
    <!-- Campo preenchido em azul claro, bem arredondado, sem borda/sublinhado -->
    <style name="Widget.TQF.TextInput" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/tqf_primary_soft</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TQF.Field</item>
        <item name="hintTextColor">@color/tqf_primary</item>
        <item name="android:textColorHint">@color/tqf_text_muted</item>
        <item name="endIconTint">@color/tqf_text_muted</item>
        <item name="startIconTint">@color/tqf_primary</item>
    </style>
    <style name="Widget.TQF.TextInput.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/tqf_primary_soft</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TQF.Field</item>
        <item name="hintTextColor">@color/tqf_primary</item>
        <item name="android:textColorHint">@color/tqf_text_muted</item>
        <item name="endIconTint">@color/tqf_primary</item>
    </style>

    <!-- ===== Chips (categorias, raio, urgência) ===== -->
    <!-- Ativo: fundo azul claro + texto azul. Inativo: só texto cinza. -->
    <style name="Widget.TQF.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/tqf_chip_bg</item>
        <item name="android:textColor">@color/tqf_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/tqf_radius_pill</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">@dimen/tqf_space_xs</item>
        <item name="chipEndPadding">@dimen/tqf_space_xs</item>
        <item name="android:textSize">@dimen/tqf_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/tqf_primary_soft_pressed</item>
    </style>

    <!-- ===== Tile de métrica (Home do prestador) ===== -->
    <style name="Widget.TQF.MetricTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">@dimen/tqf_space_md</item>
        <item name="android:paddingHorizontal">@dimen/tqf_space_xs</item>
        <item name="android:background">@drawable/bg_surface_card</item>
        <item name="android:elevation">@dimen/tqf_space_xxs</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/tqf_shadow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/tqf_shadow</item>
    </style>
    <style name="Widget.TQF.MetricTile.Icon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="tint">@color/tqf_primary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.TQF.MetricTile.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/tqf_space_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.TQF.Title</item>
    </style>
    <style name="Widget.TQF.MetricTile.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tqf_text_secondary</item>
        <item name="android:textSize">@dimen/tqf_text_micro</item>
    </style>

    <!-- ===== Badges de status ===== -->
    <style name="Widget.TQF.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">@dimen/tqf_text_micro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@string/tqf_font_medium</item>
    </style>

    <!-- ===== Switch / Diálogos ===== -->
    <style name="Widget.TQF.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/tqf_switch_thumb</item>
        <item name="trackTint">@color/tqf_switch_track</item>
    </style>
    <style name="ThemeOverlay.TQF.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TQF.Medium</item>
        <item name="colorPrimary">@color/tqf_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.TQF.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.TQF.Button.Text.Muted</item>
    </style>
    <style name="Widget.TQF.Button.Text.Muted">
        <item name="android:textColor">@color/tqf_text_secondary</item>
    </style>

    <!-- ===== Barra de navegação inferior ===== -->
    <!-- Item: só ícone (nome no contentDescription); selected = ativo (azul + fundo sutil bg_nav_item_active) -->
    <style name="Widget.TQF.NavItem" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginHorizontal">@dimen/tqf_space_xxs</item>
        <item name="android:background">@drawable/bg_nav_item_active</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.TQF.NavItem.Icon" parent="">
        <item name="tint">@color/tqf_nav_item</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

</resources>
