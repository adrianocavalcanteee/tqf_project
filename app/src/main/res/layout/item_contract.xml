<?xml version="1.0" encoding="utf-8"?>
<!-- Card de contratação no estilo "tarefa": categoria + ícone no topo, título em destaque,
     outra parte do contrato, data à esquerda e status (etiqueta pequena) à direita, ação principal. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContract"
    style="@style/Widget.TQF.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tqf_space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tqf_space_md">

        <!-- Categoria + ícone colorido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSpecialty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TQF.Caption"
                tools:text="Climatização" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.TQF.Tile" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtServiceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_xxs"
            android:textAppearance="@style/TextAppearance.TQF.Subtitle"
            android:textStyle="bold"
            tools:text="Instalação de ar-condicionado 12000 BTUs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProfessionalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TQF.Body"
                tools:text="Paulo Oliveira" />

            <ImageView
                android:id="@+id/imgVerified"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_verified"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Data à esquerda; nota e status à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtScheduleDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/tqf_primary"
                android:textSize="@dimen/tqf_text_caption"
                app:drawableStartCompat="@drawable/ic_calendar_white"
                app:drawableTint="@color/tqf_primary"
                tools:text="2026-11-22" />

            <LinearLayout
                android:id="@+id/layoutStatusRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtRatingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/tqf_space_xs"
                    android:textColor="@color/tqf_star"
                    android:textSize="@dimen/tqf_text_caption"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="★ 4,8"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtStatusBadge"
                    style="@style/Widget.TQF.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Concluído" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetails"
            style="@style/Widget.TQF.Button.Soft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_sm"
            android:text="Ver detalhes" />

        <!-- Contratante: cancelar pedido pendente (sem resposta) ou recusado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRequest"
            style="@style/Widget.TQF.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar solicitação"
            android:textColor="@color/tqf_status_refused_text"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
