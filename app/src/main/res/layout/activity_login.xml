<?xml version="1.0" encoding="utf-8"?>
<!-- Login: fundo claro com brilhos, logo e frase centralizadas e formulário em card branco flutuante. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glow"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Marca centralizada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="300dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/tqf_space_lg"
            android:paddingVertical="@dimen/tqf_space_lg">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Tem Quem Faça"
                android:src="@drawable/logo_login" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tqf_space_lg"
                android:text="Encontre quem faça,"
                android:textAppearance="@style/TextAppearance.TQF.Subtitle"
                android:textColor="@color/tqf_text_secondary"
                android:textSize="@dimen/tqf_text_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="perto de você."
                android:textAppearance="@style/TextAppearance.TQF.Display"
                android:textColor="@color/tqf_primary" />
        </LinearLayout>

        <!-- Card flutuante do formulário -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TQF.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/tqf_space_md"
            android:layout_marginBottom="@dimen/tqf_space_md"
            app:cardCornerRadius="@dimen/tqf_radius_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/tqf_screen_margin">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrar"
                    android:textAppearance="@style/TextAppearance.TQF.Headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tqf_space_xxs"
                    android:text="Escolha como você usa o TQF"
                    android:textAppearance="@style/TextAppearance.TQF.Body" />

                <!-- Segmented control Contratante | Prestador -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleUserType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tqf_space_md"
                    android:background="@drawable/bg_segment_track"
                    android:padding="@dimen/tqf_space_xxs"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeContractor"
                        style="@style/Widget.TQF.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contratante"
                        android:textColor="@color/brand_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeProvider"
                        style="@style/Widget.TQF.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Prestador"
                        android:textColor="@color/text_secondary" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tqf_space_md"
                    android:hint="E-mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tqf_space_sm"
                    android:hint="Senha"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtForgotPassword"
                    style="@style/Widget.TQF.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Esqueceu a senha?" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tqf_space_xxs"
                    android:text="Entrar como Contratante"
                    app:icon="@drawable/ic_chevron_right" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tqf_space_xs"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Não tem uma conta?"
                        android:textAppearance="@style/TextAppearance.TQF.Body"
                        android:textColor="@color/tqf_text" />

                    <TextView
                        android:id="@+id/txtRegister"
                        style="@style/Widget.TQF.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/tqf_space_xxs"
                        android:text="Cadastre-se"
                        android:textSize="@dimen/tqf_text_body" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
