<?xml version="1.0" encoding="utf-8"?>
<!-- Home do contratante: cabeçalho com saudação e localização, categorias (filtro), raio + mapa
     e recomendados perto de você (cards compactos). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/tqf_screen_margin"
            android:paddingTop="@dimen/tqf_space_lg"
            android:paddingBottom="96dp">

            <!-- Cabeçalho: avatar + "Olá!" + nome; localização abaixo; notificações à direita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgHomeAvatar"
                    android:clickable="true"
                    android:contentDescription="Abrir meu perfil"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="@dimen/tqf_avatar_md"
                    android:layout_height="@dimen/tqf_avatar_md"
                    android:background="@color/tqf_primary_soft"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.TQF.Circle"
                    tools:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/tqf_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olá!"
                        android:textAppearance="@style/TextAppearance.TQF.Caption"
                        android:textColor="@color/tqf_text_secondary" />

                    <TextView
                        android:id="@+id/txtHomeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.TQF.Title"
                        tools:text="Ana Lima" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="@dimen/tqf_touch_target"
                    android:layout_height="@dimen/tqf_touch_target"
                    android:background="@drawable/bg_surface_card"
                    android:clickable="true"
                    android:contentDescription="Notificações"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="13dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/tqf_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHomeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tqf_space_xs"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Sua região"
                android:textColor="@color/tqf_text_secondary"
                android:textSize="@dimen/tqf_text_caption"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/tqf_primary"
                tools:text="Centro, Manaus" />

            <!-- Aviso de solicitação recusada (abre o motor de recomendação). Visível só quando houver recusa. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRefusedRequest"
                style="@style/Widget.TQF.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tqf_space_md"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tqf_status_refused_bg"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/tqf_space_md">

                    <TextView
                        android:id="@+id/txtRefusedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prestador indisponível"
                        android:textColor="@color/tqf_status_refused_text"
                        android:textSize="@dimen/tqf_text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRefusedMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.TQF.Body"
                        android:textColor="@color/tqf_text"
                        tools:text="Sua solicitação foi recusada. Veja outros profissionais de Reformas e Reparos." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeeSuggestions"
                        style="@style/Widget.TQF.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver prestadores sugeridos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Categorias: chips com rolagem horizontal (filtro) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="@dimen/tqf_space_md"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/tqf_screen_margin"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_category" />

            <!-- Seção: mapa por raio de distância -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tqf_space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.TQF.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Perto de você" />

                <TextView
                    android:id="@+id/btnSeeAll"
                    style="@style/Widget.TQF.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todos" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-20dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/tqf_screen_margin"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRadius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/txtRadiusHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/tqf_space_xs"
                android:text="Cadastre seu endereço no Perfil para buscar prestadores por distância."
                android:textAppearance="@style/TextAppearance.TQF.Caption"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapContainer"
                style="@style/Widget.TQF.Card"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/tqf_space_xs">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/mapFragment"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:id="@+id/mapTouchOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Seção: recomendados perto de você (cards compactos) -->
            <TextView
                style="@style/Widget.TQF.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tqf_section_gap"
                android:text="Recomendados perto de você" />

            <TextView
                android:id="@+id/txtProfessionalsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="@dimen/tqf_space_sm"
                android:textAppearance="@style/TextAppearance.TQF.Caption"
                tools:text="12 profissionais encontrados" />

            <!-- Skeleton de carregamento (visível enquanto a lista carrega) -->
            <LinearLayout
                android:id="@+id/progressProfessionals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/item_skeleton_provider" />

                <include layout="@layout/item_skeleton_provider" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtEmptyProfessionals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/tqf_space_md"
                android:background="@drawable/bg_tile"
                android:gravity="center"
                android:padding="@dimen/tqf_space_lg"
                android:text="Nenhum prestador encontrado com estes filtros."
                android:textAppearance="@style/TextAppearance.TQF.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfessionals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_professional" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Abrir solicitação sem prestador específico: botão redondo só com o "+" -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabOpenRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/tqf_space_md"
        android:contentDescription="Abrir solicitação"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/tqf_primary"
        app:fabSize="normal"
        app:tint="@color/tqf_text_on_primary" />
</FrameLayout>
