<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Top Bar Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageView
            app:tint="@color/tqf_text"
            android:padding="12dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:background="@drawable/bg_tile"
            android:id="@+id/btnBackDetails"
            android:contentDescription="Voltar"
            android:layout_width="@dimen/tqf_touch_target"
            android:layout_height="@dimen/tqf_touch_target"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:textAppearance="@style/TextAppearance.TQF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Detalhes do Serviço" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Main Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/tqf_radius_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            tools:text="Em andamento"
                            android:textColor="@color/brand_blue"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.TQF.Title"
                            android:id="@+id/txtDetailPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            tools:text="R$ 150,00" />
                    </RelativeLayout>

                    <TextView
                        android:textAppearance="@style/TextAppearance.TQF.Headline"
                        android:id="@+id/txtDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        tools:text="Instalação de tomadas e iluminação" />

                    <TextView
                        android:textAppearance="@style/TextAppearance.TQF.Body"
                        android:id="@+id/txtDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Serviço completo de passagem de fiação, instalação de tomadas 20A e luminárias LED em cômodos residenciais."
                        android:lineSpacingExtra="3dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/card_stroke" />

                    <!-- Professional / Client Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_profile"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:textAppearance="@style/TextAppearance.TQF.Title"
                                android:id="@+id/txtDetailProfessionalName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Carlos Mendes" />

                            <TextView
                                android:textAppearance="@style/TextAppearance.TQF.Body"
                                android:id="@+id/txtDetailSpecialty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Eletricista Residencial" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Date & Time Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar_white"
                            app:tint="@color/brand_blue"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtDetailSchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            tools:text="15 de mar. de 2025 • 09:00"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Service Evidence / Photos Section (Provider Only) -->
            <LinearLayout
                android:id="@+id/layoutEvidenceSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:textAppearance="@style/TextAppearance.TQF.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Evidências do Serviço (Fotos)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddEvidence"
                    style="@style/Widget.TQF.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginTop="8dp"
                    android:text="Adicionar Foto de Evidência"
                    android:textColor="@color/brand_blue"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/brand_blue"
                    app:strokeColor="@color/brand_blue"
                    app:strokeWidth="1dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvServiceEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_portfolio" />
            </LinearLayout>

            <!-- Review Button (Shown when Service is Concluded) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="⭐ Avaliar Atendimento"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>