<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                app:tint="@color/tqf_text"
                android:padding="12dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_tile"
                android:id="@+id/btnBack"
                android:contentDescription="Voltar"
                android:layout_width="@dimen/tqf_touch_target"
                android:layout_height="@dimen/tqf_touch_target"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Perfil do Profissional" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnFavorite"
                    android:contentDescription="Favoritar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_heart"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnShare"
                    android:contentDescription="Compartilhar perfil"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Cover & Avatar Container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Foto de capa (perfis_prestador.cover_url); sem capa: degradê azul -->
            <ImageView
                android:id="@+id/imgCover"
                android:contentDescription="Foto de capa"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_cover_placeholder"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <!-- Botão de capa (somente no próprio perfil) -->
            <LinearLayout
                android:id="@+id/btnChangeCover"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tqf_touch_target"
                android:layout_alignTop="@id/imgCover"
                android:layout_alignEnd="@id/imgCover"
                android:layout_margin="@dimen/tqf_space_sm"
                android:background="@drawable/bg_back_button"
                android:clickable="true"
                android:contentDescription="Alterar foto de capa"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/tqf_space_sm">

                <ImageView
                    android:layout_width="@dimen/tqf_icon_sm"
                    android:layout_height="@dimen/tqf_icon_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/tqf_text" />

                <TextView
                    android:id="@+id/txtChangeCover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Adicionar capa"
                    android:textColor="@color/tqf_text"
                    android:textSize="@dimen/tqf_text_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Overlapping Avatar -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="85dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile"
                    app:strokeWidth="3dp"
                    app:strokeColor="@color/card_bg"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.TQF.Circle"
                    android:clickable="true"
                    android:focusable="true"
                    tools:ignore="ContentDescription" />

                <!-- Edit Avatar Camera Badge -->
                <FrameLayout
                    android:id="@+id/btnChangeAvatar"
                    android:contentDescription="Alterar foto de perfil"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignEnd="@id/imgAvatar"
                    android:layout_alignBottom="@id/imgAvatar"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginBottom="-4dp"
                    android:elevation="4dp"
                    android:background="@drawable/bg_circle_blue"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        tools:ignore="ContentDescription" />
                </FrameLayout>
            </RelativeLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Name + Verified Badge + Edit Profile Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:textAppearance="@style/TextAppearance.TQF.Headline"
                        android:id="@+id/txtProfessionalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="João Ferreira" />

                    <ImageView
                        android:id="@+id/imgVerified"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_verified"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <!-- Editar Perfil Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Editar perfil"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@color/tqf_primary_soft"
                    app:strokeColor="@color/tqf_primary_soft_pressed"
                    app:strokeWidth="1dp" />
            </RelativeLayout>

            <!-- Specialty -->
            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Body"
                android:id="@+id/txtSpecialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Técnico de TI" />

            <!-- Rating Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/txtRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Novo no TQF"
                    tools:text="5,0 (0 avaliações)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stats Summary Cards (2 items) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/tqf_radius_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="4dp">

                    <!-- Stat 2: Services -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_briefcase"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtCompletedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            tools:text="89"
                            android:textColor="@color/brand_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Serviços realizados"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/tqf_text_caption" />
                    </LinearLayout>

                    <!-- Stat 3: Verified -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_verified"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Verificado"
                            android:textColor="@color/brand_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Conta profissional"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/tqf_text_caption" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action CTA Button -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- Button: Solicitar Serviço -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRequestService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingHorizontal="4dp"
                    android:text="Solicitar Serviço"
                    app:icon="@drawable/ic_briefcase"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp" />
            </LinearLayout>

            <!-- "Sobre mim" Section -->
            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sobre mim" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="@dimen/tqf_radius_card">

                <TextView
                    android:textAppearance="@style/TextAppearance.TQF.Body"
                    android:id="@+id/txtBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    tools:text="Sou técnico de TI com mais de 5 anos de experiência em manutenção de computadores, notebooks e redes. Trabalho com agilidade, transparência e foco em resolver o seu problema."
                    android:lineSpacingExtra="4dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- "Localização do Escritório" Section (Google Maps) -->
            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Title"
                android:id="@+id/txtOfficeMapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Localização do Escritório" />

            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Body"
                android:id="@+id/txtOfficeAddressSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Carregando endereço..." />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapContainer"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="@dimen/tqf_radius_card">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapOffice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:liteMode="true" />

            </com.google.android.material.card.MaterialCardView>

            <!-- "Serviços" Section (Chips) -->
            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Serviços oferecidos" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formatação"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/brand_blue"
                    app:chipBackgroundColor="@color/tqf_primary_soft"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/tqf_primary_soft_pressed"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Montagem de PC"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/brand_blue"
                    app:chipBackgroundColor="@color/tqf_primary_soft"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/tqf_primary_soft_pressed"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redes e Wi-Fi"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/brand_blue"
                    app:chipBackgroundColor="@color/tqf_primary_soft"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/tqf_primary_soft_pressed"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suporte remoto"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/brand_blue"
                    app:chipBackgroundColor="@color/tqf_primary_soft"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/tqf_primary_soft_pressed"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manutenção preventiva"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/brand_blue"
                    app:chipBackgroundColor="@color/tqf_primary_soft"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/tqf_primary_soft_pressed"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- "Portfólio" Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:textAppearance="@style/TextAppearance.TQF.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Portfólio" />

                <TextView
                    android:id="@+id/btnSeeAllPortfolio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ver todos >"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Portfolio Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPortfolio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_portfolio" />

            <TextView
                android:id="@+id/txtNoPortfolio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhuma foto no portfólio. Toque em editar perfil para adicionar."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- "Avaliações" Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:textAppearance="@style/TextAppearance.TQF.Title"
                    android:id="@+id/txtReviewsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avaliações (0)"
                    tools:text="Avaliações (0)" />

                <TextView
                    android:id="@+id/btnSeeAllReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ver todas >"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Reviews List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="1"
                tools:listitem="@layout/item_review" />

            <!-- Provider Management Menu Card (Logout Option) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProviderMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="@dimen/tqf_radius_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <!-- Sair da Conta (Logout) -->
                    <RelativeLayout
                        android:id="@+id/menuLogoutProvider"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                        android:background="@drawable/bg_tile"
                        android:padding="8dp"
                        app:tint="@color/tqf_heart"
                            android:id="@+id/iconLogoutProvider"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_logout"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/iconLogoutProvider"
                            android:layout_marginStart="14dp"
                            android:text="Sair da conta"
                            android:textColor="@color/tqf_heart"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            tools:ignore="ContentDescription" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>