<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:textAppearance="@style/TextAppearance.TQF.Title"
        android:id="@+id/txtReviewDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avaliar Serviço Concluído" />

    <TextView
        android:textAppearance="@style/TextAppearance.TQF.Body"
        android:id="@+id/txtReviewDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Como foi a sua experiência com este atendimento?"
        android:gravity="center" />

    <!-- Star Rating Bar -->
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:numStars="5"
        android:rating="0"
        android:stepSize="1.0"
        android:progressTint="@color/tqf_star"
        android:progressBackgroundTint="@color/text_muted" />

    <!-- Comment Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TQF.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Escreva sua avaliação (opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>