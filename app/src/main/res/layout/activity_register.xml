<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_glow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tqf_screen_margin"
        android:paddingTop="@dimen/tqf_space_md"
        android:paddingBottom="@dimen/tqf_space_lg">

        <!-- Cabeçalho: voltar + título grande + subtítulo -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tqf_touch_target"
            android:layout_height="@dimen/tqf_touch_target"
            android:background="@drawable/bg_tile"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/tqf_space_sm"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/tqf_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_md"
            android:text="Criar conta"
            android:textAppearance="@style/TextAppearance.TQF.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_xxs"
            android:text="Cadastre-se para contratar ou oferecer serviços."
            android:textAppearance="@style/TextAppearance.TQF.Body" />

        <!-- Register Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="@dimen/tqf_radius_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Profile Picture Selection Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/containerAvatar"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:cardCornerRadius="@dimen/tqf_radius_card"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/brand_blue"
                            app:strokeWidth="2dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/imgRegisterAvatar"
                                android:contentDescription="Escolher foto de perfil"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_profile" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Camera Badge Overlay (posicionado sobre a borda inferior direita) -->
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="-4dp"
                            android:layout_marginBottom="-4dp"
                            android:elevation="4dp"
                            android:background="@drawable/bg_circle_blue"
                            android:src="@drawable/ic_camera"
                            android:padding="6dp"
                            app:tint="@color/white"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtSelectAvatarLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Adicionar Foto de Perfil"
                        android:textColor="@color/brand_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:textAppearance="@style/TextAppearance.TQF.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Perfil" />

                <!-- User Type Selector (Contratante vs Prestador) -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleRegisterUserType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_segment_track"
                    android:padding="@dimen/tqf_space_xxs"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegisterContractor"
                        style="@style/Widget.TQF.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contratante"
                        android:textColor="@color/brand_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegisterProvider"
                        style="@style/Widget.TQF.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Prestador"
                        android:textColor="@color/text_secondary" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Full Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome Completo *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="E-mail *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPhone"
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Telefone / WhatsApp *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Senha *"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.TQF.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Confirmar Senha *"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Container para Campos Específicos do Prestador de Serviço -->
                <LinearLayout
                    android:id="@+id/layoutProviderFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/card_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informações do Serviço / Escritório"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Category Exposed Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCategory"
                        style="@style/Widget.TQF.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Categoria Principal *">

                        <AutoCompleteTextView
                            android:id="@+id/actvCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:ignore="LabelFor" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Specialty Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSpecialty"
                        style="@style/Widget.TQF.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Especialidade / Título do Serviço *"
                        app:placeholderText="Ex: Eletricista Residencial e Predial">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSpecialty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Address Search Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLocation"
                        style="@style/Widget.TQF.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Endereço do Escritório (Rua, Número, Bairro, Cidade)"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_search"
                        app:endIconContentDescription="Buscar Endereço">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            tools:text="Av. Paulista, 1000, São Paulo" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Button: Buscar e Converter Endereço em Coordenadas -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearchAddress"
                        style="@style/Widget.TQF.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="📍 Localizar e Posicionar no Mapa"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp"
                        app:strokeColor="@color/brand_blue"
                        app:strokeWidth="1dp" />

                    <!-- Status Feedback -->
                    <TextView
                        android:id="@+id/txtLocationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="✓ Endereço localizado com sucesso!"
                        android:textColor="@color/green_badge_text"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Map Preview Container for Registration -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRegisterMap"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="@dimen/tqf_radius_card"
                        app:cardElevation="@dimen/tqf_elevation_card">

                        <com.google.android.gms.maps.MapView
                            android:id="@+id/registerMapView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Overlay for handling scroll conflicts if needed -->
                        <View
                            android:id="@+id/registerMapTouchOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Hidden / Optional Advanced Coordinates -->
                    <LinearLayout
                        android:id="@+id/layoutManualCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLatitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="-23.550520" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLongitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="-46.633308" />
                    </LinearLayout>

                    <!-- Portfolio Section (Imagens do Portfólio) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/card_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Portfólio / Trabalhos Realizados"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Adicione fotos de serviços anteriores para seu perfil (máx. 5 fotos)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPortfolio"
                        style="@style/Widget.TQF.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Adicionar Fotos ao Portfólio"
                        android:textColor="@color/brand_blue"
                        app:icon="@drawable/ic_camera"
                        app:iconTint="@color/brand_blue"
                        app:strokeColor="@color/brand_blue"
                        app:strokeWidth="1dp" />

                    <!-- Horizontal Previews of Portfolio Images -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPortfolioPreviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_portfolio" />

                </LinearLayout>

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Finalizar Cadastro" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Login Footer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já possui uma conta? " />

            <TextView
                android:id="@+id/txtLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faça Login"
                android:textColor="@color/brand_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>