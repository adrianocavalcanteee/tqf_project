<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgReviewerAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/imgReviewerAvatar"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtReviewerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mariana Costa"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 5 Stars Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" tools:ignore="ContentDescription" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" tools:ignore="ContentDescription" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" tools:ignore="ContentDescription" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" tools:ignore="ContentDescription" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" tools:ignore="ContentDescription" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtReviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="10 de mar. de 2025"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txtReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Excelente profissional! Resolveu meu problema com muita agilidade. Recomendo!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>