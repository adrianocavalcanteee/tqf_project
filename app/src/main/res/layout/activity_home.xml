<?xml version="1.0" encoding="utf-8"?>
<!-- Container das abas + pílula de navegação flutuante em vidro (item ativo: azul com fundo sutil). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glow">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/cardBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        style="@style/Widget.TQF.Card"
        android:layout_width="0dp"
        android:layout_height="@dimen/tqf_bottom_nav_height"
        android:layout_marginHorizontal="@dimen/tqf_screen_margin"
        android:layout_marginTop="@dimen/tqf_space_xs"
        android:layout_marginBottom="@dimen/tqf_space_md"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/tqf_radius_nav"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Efeito de vidro (bg_nav_glass) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_glass"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/tqf_space_xs">

            <LinearLayout
                android:id="@+id/btnNavHome"
                android:contentDescription="Início"
                style="@style/Widget.TQF.NavItem"
                android:layout_width="0dp"
                android:layout_height="@dimen/tqf_touch_target"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/iconHome"
                    style="@style/Widget.TQF.NavItem.Icon"
                    android:layout_width="@dimen/tqf_icon_md"
                    android:layout_height="@dimen/tqf_icon_md"
                    android:src="@drawable/ic_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavContracts"
                android:contentDescription="Contratações"
                style="@style/Widget.TQF.NavItem"
                android:layout_width="0dp"
                android:layout_height="@dimen/tqf_touch_target"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/iconContracts"
                    style="@style/Widget.TQF.NavItem.Icon"
                    android:layout_width="@dimen/tqf_icon_md"
                    android:layout_height="@dimen/tqf_icon_md"
                    android:src="@drawable/ic_contracts" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavProfile"
                android:contentDescription="Perfil"
                style="@style/Widget.TQF.NavItem"
                android:layout_width="0dp"
                android:layout_height="@dimen/tqf_touch_target"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/iconProfile"
                    style="@style/Widget.TQF.NavItem.Icon"
                    android:layout_width="@dimen/tqf_icon_md"
                    android:layout_height="@dimen/tqf_icon_md"
                    android:src="@drawable/ic_profile" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
