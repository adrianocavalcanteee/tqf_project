<?xml version="1.0" encoding="utf-8"?>
<!-- Motor de recomendação: prestadores da MESMA categoria após uma recusa. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glow"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <ImageButton
            app:tint="@color/tqf_text"
            android:padding="12dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:background="@drawable/bg_tile"
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tqf_touch_target"
            android:layout_height="@dimen/tqf_touch_target"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:textAppearance="@style/TextAppearance.TQF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prestadores sugeridos" />
    </LinearLayout>

    <TextView
        android:textAppearance="@style/TextAppearance.TQF.Body"
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        tools:text="O prestador não está disponível para &quot;Troca de disjuntor&quot;. Veja outros profissionais de Reformas e Reparos:" />

    <ProgressBar
        android:id="@+id/progressSuggestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:textAppearance="@style/TextAppearance.TQF.Body"
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:text="Nenhum outro prestador disponível nesta categoria no momento."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp"
        tools:listitem="@layout/item_professional" />

    <!-- Alternativa às sugestões: o contratante encerra o pedido recusado -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelService"
        style="@style/Widget.TQF.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="Cancelar serviço"
        android:textColor="@color/tqf_status_refused_text"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
