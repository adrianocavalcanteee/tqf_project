<?xml version="1.0" encoding="utf-8"?>
<!-- Tile de informação/serviço (estilo "Facilities"): quadrado azul claro com ícone + rótulo pequeno -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tqf_space_xxs"
    android:paddingBottom="@dimen/tqf_space_sm">

    <ImageView
        android:id="@+id/imgTileIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_tile"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/tqf_primary" />

    <TextView
        android:id="@+id/txtTileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/tqf_text_secondary"
        android:textSize="@dimen/tqf_text_micro"
        tools:text="Instalação elétrica" />
</LinearLayout>
