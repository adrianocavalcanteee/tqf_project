<?xml version="1.0" encoding="utf-8"?>
<!-- Home do prestador: saudação, disponibilidade, métricas em tiles, busca e solicitações recebidas. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tqf_screen_margin"
        android:paddingTop="@dimen/tqf_space_lg"
        android:paddingBottom="@dimen/tqf_space_lg">

        <!-- Cabeçalho: avatar + "Olá!" + nome; notificações à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProviderAvatar"
                android:clickable="true"
                android:contentDescription="Abrir meu perfil"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/tqf_avatar_md"
                android:layout_height="@dimen/tqf_avatar_md"
                android:background="@color/tqf_primary_soft"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.TQF.Circle"
                tools:src="@drawable/ic_profile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tqf_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá!"
                    android:textAppearance="@style/TextAppearance.TQF.Caption"
                    android:textColor="@color/tqf_text_secondary" />

                <TextView
                    android:id="@+id/txtProviderGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Prestador"
                    android:textAppearance="@style/TextAppearance.TQF.Title"
                    tools:text="João Ferreira" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgNotificationProvider"
                android:layout_width="@dimen/tqf_touch_target"
                android:layout_height="@dimen/tqf_touch_target"
                android:background="@drawable/bg_surface_card"
                android:clickable="true"
                android:contentDescription="Notificações"
                android:elevation="2dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/tqf_text" />
        </LinearLayout>

        <!-- Resumo dos serviços (anel = concluídos / aceitos) -->
        <include
            android:id="@+id/cardSummary"
            layout="@layout/view_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_md" />

        <!-- Disponível para chamados: perfis_prestador.is_available -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusToggle"
            style="@style/Widget.TQF.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/tqf_space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Disponível 🟢"
                        android:textAppearance="@style/TextAppearance.TQF.Subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Clientes só encontram você quando disponível"
                        android:textAppearance="@style/TextAppearance.TQF.Caption" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="@dimen/tqf_touch_target" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Métricas (tiles) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Widget.TQF.MetricTile"
                android:layout_marginEnd="@dimen/tqf_space_xs">

                <ImageView
                    style="@style/Widget.TQF.MetricTile.Icon"
                    android:src="@drawable/ic_clipboard" />

                <TextView
                    android:id="@+id/txtQuotesCount"
                    style="@style/Widget.TQF.MetricTile.Value"
                    android:text="0"
                    tools:text="8" />

                <TextView
                    style="@style/Widget.TQF.MetricTile.Label"
                    android:text="Pedidos\nrecebidos" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.TQF.MetricTile"
                android:layout_marginHorizontal="@dimen/tqf_space_xxs">

                <ImageView
                    style="@style/Widget.TQF.MetricTile.Icon"
                    android:src="@drawable/ic_briefcase" />

                <TextView
                    android:id="@+id/txtActiveServicesCount"
                    style="@style/Widget.TQF.MetricTile.Value"
                    android:text="0"
                    tools:text="3" />

                <TextView
                    style="@style/Widget.TQF.MetricTile.Label"
                    android:text="Em\nandamento" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.TQF.MetricTile"
                android:layout_marginStart="@dimen/tqf_space_xs">

                <ImageView
                    style="@style/Widget.TQF.MetricTile.Icon"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/txtCompletedServicesCount"
                    style="@style/Widget.TQF.MetricTile.Value"
                    android:text="0"
                    tools:text="5" />

                <TextView
                    style="@style/Widget.TQF.MetricTile.Label"
                    android:text="Serviços\nconcluídos" />
            </LinearLayout>
        </LinearLayout>

        <!-- Busca nas solicitações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/tqf_field_height"
            android:layout_marginTop="@dimen/tqf_space_md"
            android:background="@drawable/bg_field_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/tqf_space_md">

            <ImageView
                android:layout_width="@dimen/tqf_icon_sm"
                android:layout_height="@dimen/tqf_icon_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/tqf_text_muted" />

            <EditText
                android:id="@+id/etSearchRequests"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/tqf_space_sm"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Buscar solicitações"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/tqf_text"
                android:textColorHint="@color/tqf_text_muted"
                android:textSize="@dimen/tqf_text_body" />
        </LinearLayout>

        <!-- Cabeçalho de seção -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.TQF.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Solicitações na sua região" />

            <TextView
                android:id="@+id/btnSeeAllRequests"
                style="@style/Widget.TQF.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver todas" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServiceRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_xs"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_service_request" />

        <TextView
            android:id="@+id/txtEmptyRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/tqf_space_md"
            android:background="@drawable/bg_tile"
            android:gravity="center"
            android:padding="@dimen/tqf_space_lg"
            android:text="Nenhuma solicitação pendente no momento."
            android:textAppearance="@style/TextAppearance.TQF.Body"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
