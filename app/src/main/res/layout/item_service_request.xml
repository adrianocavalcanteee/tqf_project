<?xml version="1.0" encoding="utf-8"?>
<!-- Card de solicitação recebida (Home do prestador e "Ver todas"): cliente + status, pedido,
     local/urgência e ação para avaliar (Aceitar/Recusar ficam na tela de avaliação). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardServiceRequest"
    style="@style/Widget.TQF.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tqf_space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tqf_space_md">

        <!-- Cliente, categoria e status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgClientAvatar"
                android:layout_width="@dimen/tqf_avatar_md"
                android:layout_height="@dimen/tqf_avatar_md"
                android:background="@color/tqf_primary_soft"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.TQF.Circle"
                app:tint="@color/tqf_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tqf_space_sm"
                android:layout_marginEnd="@dimen/tqf_space_xs"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtClientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.TQF.Subtitle"
                    android:textStyle="bold"
                    tools:text="Ana Lima" />

                <TextView
                    android:id="@+id/txtPostedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TQF.Caption"
                    tools:text="2026-11-22" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCategoryBadge"
                style="@style/Widget.TQF.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/tqf_primary"
                tools:text="Eventos" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRequestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_sm"
            android:textAppearance="@style/TextAppearance.TQF.Subtitle"
            android:textStyle="bold"
            tools:text="Instalação de ar-condicionado 12000 BTUs" />

        <TextView
            android:id="@+id/txtRequestDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_xxs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.TQF.Body"
            tools:text="Preciso de profissional qualificado para instalação de ar split na sala." />

        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_sm"
            android:background="@drawable/bg_tile"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/tqf_space_sm"
            android:paddingVertical="@dimen/tqf_space_xs"
            android:textColor="@color/tqf_text_secondary"
            android:textSize="@dimen/tqf_text_caption"
            app:drawableStartCompat="@drawable/ic_location"
            app:drawableTint="@color/tqf_primary"
            tools:text="Pedido aberto • Hoje • Centro • 1,8 km" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEvaluateService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tqf_space_md"
            android:text="Ver e responder"
            app:icon="@drawable/ic_chevron_right" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
