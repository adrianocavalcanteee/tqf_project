<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton do card compacto de prestador (carregamento) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.TQF.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tqf_space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/tqf_space_sm">

        <View
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_skeleton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tqf_space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="@dimen/tqf_space_sm"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="90dp"
                android:layout_height="12dp"
                android:layout_marginTop="@dimen/tqf_space_sm"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
