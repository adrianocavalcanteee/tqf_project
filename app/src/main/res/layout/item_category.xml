<?xml version="1.0" encoding="utf-8"?>
<!-- Chip de categoria (filtro da Home): ícone + nome. Ativo (selected): fundo azul claro e texto azul;
     inativo: só texto cinza. O clique continua abrindo as subcategorias (HomeFragment). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginEnd="@dimen/tqf_space_xs"
    android:background="@drawable/bg_pill"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/tqf_space_md">

    <ImageView
        android:id="@+id/imgCategoryIcon"
        android:layout_width="@dimen/tqf_icon_sm"
        android:layout_height="@dimen/tqf_icon_sm"
        app:tint="@color/tqf_pill_content"
        tools:ignore="ContentDescription"
        tools:src="@drawable/ic_tech_repair" />

    <TextView
        android:id="@+id/txtCategoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tqf_space_xs"
        android:maxLines="1"
        android:textColor="@color/tqf_pill_content"
        android:textSize="@dimen/tqf_text_body"
        android:textStyle="bold"
        tools:text="Reformas e Reparos" />
</LinearLayout>
