<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário de descrição do serviço. Direto (Contratante ➔ Prestador) ou pedido aberto (categoria).
     Ao enviar, status = PENDENTE. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glow"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <ImageButton
            app:tint="@color/tqf_text"
            android:padding="12dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:background="@drawable/bg_tile"
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tqf_touch_target"
            android:layout_height="@dimen/tqf_touch_target"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:textAppearance="@style/TextAppearance.TQF.Title"
            android:id="@+id/txtScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição do serviço" />
    </LinearLayout>

    <!-- Formulário -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:textAppearance="@style/TextAppearance.TQF.Body"
                android:id="@+id/txtProviderInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Para: Carlos Mendes • Reformas e Reparos" />

            <!-- Somente no pedido aberto: a categoria define quais prestadores recebem a demanda -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategory"
                style="@style/Widget.TQF.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Categoria do serviço"
                android:visibility="gone"
                tools:visibility="visible">

                <AutoCompleteTextView
                    android:id="@+id/actvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilServiceTitle"
                style="@style/Widget.TQF.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Título do serviço (ex.: Troca de fiação)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServiceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilServiceDescription"
                style="@style/Widget.TQF.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Descreva o que precisa ser feito"
                app:counterEnabled="true"
                app:counterMaxLength="500"
                app:helperText="Inclua detalhes que ajudem o prestador a decidir.">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServiceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Urgência"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupUrgency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="false"
                app:singleSelection="true" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLocation"
                style="@style/Widget.TQF.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Local do serviço (bairro, cidade)"
                app:helperText="Ajuda o prestador a saber a distância até você.">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapWords"
                    android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilClientPhone"
                style="@style/Widget.TQF.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Seu WhatsApp com DDD"
                app:helperText="O prestador entrará em contato por aqui se aceitar.">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClientPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Enviar solicitação" />

            <ProgressBar
                android:id="@+id/progressSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Estado "Serviço enviado" (PENDENTE) -->
    <LinearLayout
        android:id="@+id/layoutSuccess"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/green_badge_text" />

        <TextView
            android:textAppearance="@style/TextAppearance.TQF.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Serviço enviado!" />

        <TextView
            android:id="@+id/txtSuccessStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Status: Pendente"
            android:textColor="@color/brand_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:textAppearance="@style/TextAppearance.TQF.Body"
            android:id="@+id/txtSuccessMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            tools:text="Aguarde a resposta de Carlos Mendes. Se aceitar, ele falará com você pelo WhatsApp." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Voltar ao início" />
    </LinearLayout>

</LinearLayout>
